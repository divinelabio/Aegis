# ==============================================================================
# Aegis Environment Configuration Template (.env.example)
# Copy to aegis.env or .env and configure for your deployment environment
# ==============================================================================

# Administrator bootstrap password (used on initial Day-1 setup when DB is empty)
AEGIS_ADMIN_PASSWORD=change-me-to-a-secure-password

# PostgreSQL control-plane database credentials (mandatory for Aegis operation)
AEGIS_CONTROL_DB_HOST=127.0.0.1
AEGIS_CONTROL_DB_PORT=5433
AEGIS_CONTROL_DB_NAME=aegis
AEGIS_CONTROL_DB_USER=aegis
AEGIS_CONTROL_DB_PASSWORD=change-me-control-db-password

# Analytics storage defaults to PostgreSQL (reusing the control-plane database with 30-day retention).
# Optional: ClickHouse analytics database credentials when driver is switched to clickhouse
AEGIS_ANALYTICS_DRIVER=postgresql
AEGIS_ANALYTICS_RETENTION_DAYS=30
AEGIS_ANALYTICS_DB_HOST=127.0.0.1
AEGIS_ANALYTICS_DB_PORT=9000
AEGIS_ANALYTICS_DB_NAME=aegis
AEGIS_ANALYTICS_DB_USER=default
AEGIS_ANALYTICS_DB_PASSWORD=
