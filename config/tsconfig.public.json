{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "rootDir": "../web/public/src",
    "outDir": "../web/public/js",
    "removeComments": true
  },
  "include": [
    "../web/public/src/**/*.ts",
    "../web/public/src/**/*.d.ts"
  ]
}
