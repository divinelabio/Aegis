{
  "name": "aegis-admin-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Admin UI tooling for incremental TypeScript migration",
  "scripts": {
    "admin:build": "npm --prefix web/admin run build",
    "admin:typecheck": "npm --prefix web/admin run typecheck",
    "geo:guardrails": "node scripts/geo-identity-guard.mjs",
    "prod:clean:audit": "node scripts/prod-clean-audit.mjs",
    "admin:verify": "npm run geo:guardrails",
    "react:build": "npm --prefix web/admin run build",
    "react:typecheck": "npm --prefix web/admin run typecheck",
    "react:dev": "npm --prefix web/admin run dev",
    "public:build": "tsc -p config/tsconfig.public.json",
    "build:all": "npm run react:build && npm run public:build"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
